<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Automation Suite" parallel="none">
    <listeners>
        <listener class-name="framework.listeners.ReportListener"/>
    </listeners>
    <test name="Cucumber UI">
        <classes>
            <class name="runners.BankingTestRunner"/>
        </classes>
    </test>
    <test name="API">
        <groups><run><include name="api"/></run></groups>
        <packages><package name="tests"/></packages>
    </test>
</suite>
